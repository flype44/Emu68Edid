
    SECTION  .text

    XDEF     _LE32
    XDEF     _Swap32

;------------------------------------------------------------------------------
; ULONG LE32(ULONG a)
; D0         D0
;------------------------------------------------------------------------------

    CNOP     0,4
_LE32:
    ror.w    #8,d0
    swap     d0
    ror.w    #8,d0
    rts

;------------------------------------------------------------------------------
; VOID Swap32(ULONG * buffer, ULONG size)
;             A0              D0
;------------------------------------------------------------------------------

    CNOP     0,4
_Swap32:
    tst.l    d0
    beq.s    _Swap32Done
_Swap32Loop:
    move.l   (a0),d1
    ror.w    #8,d1
    swap     d1
    ror.w    #8,d1
    move.l   d1,(a0)+
    subq.l   #1,d0
    bne.s    _Swap32Loop
_Swap32Done:
    rts

    END
